# --- AI providers (set at least one; the app auto-falls-through between them) ---

# Google Gemini — free key, no credit card: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenRouter — free key unlocks many ":free" models: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional overrides
GEMINI_MODEL=gemini-flash-latest
PORT=3000
